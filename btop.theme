
# Main background
theme[main_bg]="#0D0D0D"

# Main text color
theme[main_fg]="#ebdbb2"

# Title color for boxes (Sage Green as requested)
theme[title]="#4D574E"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#D35F5F"

# Background color of selected item in processes box
theme[selected_bg]="#303531"

# Foreground color of selected item in processes box
theme[selected_fg]="#a3850e"

# Color of inactive/disabled text (Dark Mustard-Olive)
theme[inactive_fg]="#4D574E"

# Color of text appearing on top of graphs
theme[graph_text]="#ebdbb2"

# Background color of the percentage meters
theme[meter_bg]="#5b4a08"

# Misc colors for processes box (mini cpu graphs, details, status text)
theme[proc_misc]="#BFA75D"

# CPU, Memory, Network, Proc box outline colors (Gold & Bronze focus)
theme[cpu_box]="#a3850e"
theme[mem_box]="#a3850e"
theme[net_box]="#a3850e"
theme[proc_box]="#a3850e"

# Box divider line and small boxes line color (Matching Inactive)
theme[div_line]="#4D574E"

# Temperature graph color (Bronze → Gold → Red peak)
theme[temp_start]="#ebdbb2"
theme[temp_mid]="#a3850e"
theme[temp_end]="#D35F5F"

# CPU graph colors (Gold → Tan Gold → Deep Red)
theme[cpu_start]="#BFA75D"
theme[cpu_mid]="#a3850e"
theme[cpu_end]="#D35F5F"

# Mem/Disk free meter (Bronze transition)
theme[free_start]="#ECAA4D"
theme[free_mid]="#a3850e"
theme[free_end]="#ebdbb2"

# Mem/Disk cached meter
theme[cached_start]="#a3850e"
theme[cached_mid]="#BFA75D"
theme[cached_end]="#ebdbb2"

# Mem/Disk available meter
theme[available_start]="#a3850e"
theme[available_mid]="#BFA75D"
theme[available_end]="#ebdbb2"

# Mem/Disk used meter (Gold → Red)
theme[used_start]="#ebdbb2"
theme[used_mid]="#BFA75D"
theme[used_end]="#D35F5F"

# Download graph colors
theme[download_start]="#ebdbb2"
theme[download_mid]="#a3850e"
theme[download_end]="#D35F5F"

# Upload graph colors
theme[upload_start]="#ebdbb2"
theme[upload_mid]="#a3850e"
theme[upload_end]="#D35F5F"

# Process box color gradient
theme[process_start]="#ebdbb2"
theme[process_mid]="#a3850e"
theme[process_end]="#D35F5F"

# Graph gradient colors
theme[gradient_color_0]="#0D0D0D"
theme[gradient_color_1]="#303531"
theme[gradient_color_2]="#5b4a08"
theme[gradient_color_3]="#4D574E"
theme[gradient_color_4]="#6E6A58"
theme[gradient_color_5]="#ebdbb2"
theme[gradient_color_6]="#a3850e"
theme[gradient_color_7]="#D35F5F"